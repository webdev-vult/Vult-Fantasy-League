NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Defaults to the permanent Vult EPL competition.
PRIMARY_COMPETITION_SLUG=vult-epl-fantasy-league

# Optional. Must remain on https://fantasy.premierleague.com.
FPL_BASE_URL=https://fantasy.premierleague.com/api

# Recommended. Server-only HMAC secret used to pseudonymise public registration
# rate-limit keys. When omitted, the server falls back to SUPABASE_SERVICE_ROLE_KEY.
# Generate a long random value and never expose it as NEXT_PUBLIC_*.
REGISTRATION_RATE_LIMIT_SECRET=
